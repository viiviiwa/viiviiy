---
import { Image } from "astro:assets";
import viivii_ig from "../assets/images/ig logo2.png";
import viivii_mail from "../assets/images/viiviiy_mail2.png";
---

<footer class="footer">
  <div class="icons">
    <span class="ig">
      <a href="https://www.instagram.com/pokitokki/">
        <Image src={viivii_ig} alt="instagram" />
      </a>
    </span>
    <span class="em">
      <a href="mailto:pokiitokki@gmail.com">
        <Image src={viivii_mail} alt="mail" />
      </a>
    </span>
  </div>
  <p class="foot-text">
    &copy; pokitokki <span id="year"></span>
    <br />
  </p>

  <script>
    document.addEventListener("DOMContentLoaded", () => {
      const year = document.getElementById("year");
      if (year) {
        year.textContent = new Date().getFullYear().toString();
      }
    });
  </script>
</footer>
