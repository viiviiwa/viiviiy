---
import Layout from "../layouts/Layout.astro";
import Header from "../components/Header.astro";
import "../styles/footer.css";
import "../styles/anim.css";

import showReel from "../assets/videos/2dAnimation.mp4";
---

<Layout>
  <Header />

  <body>
    <section>
      <div class="header">
        <h1>animation</h1>
        <p>2D character animation & motion graphics</p>
      </div>

      <video controls class="video" src={showReel}>
        <source src={showReel} type="video/mp4" />
        Your browser does not support the video tag.
      </video>
    </section>
  </body>
</Layout>
