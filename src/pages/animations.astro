---
import Layout from "../layouts/Layout.astro";
import showReel2025 from "../assets/videos/2025_ShowReel.mov";
---

<Layout>
  <h1 class="animh1">⊹ my animation reel ⊹</h1>
  <video controls class="video" src={showReel2025} type="video/mp4"> </video>

  <div class="footer">
    <span class="icons">
      <span class="ig"
        ><a href="https://www.instagram.com/pokitokki/">
          <img src="source_images/viiviiy_ig.png" />
        </a>
      </span>
      <span class="em">
        <a href="mailto:pokiitokki@gmail.com">
          <img src="source_images/viiviiy_mail.png" />
        </a>
      </span>
    </span>
    <p class="foot-text">
      &copy; pokitokki 2025<br /><span class="foot-date">July 2025</span>
    </p>
    <!--doodles on both sides of the foot -->
  </div>
</Layout>
