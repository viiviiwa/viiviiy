---
import Layout from "../layouts/Layout.astro";
import Header from "../components/Header.astro";
import "../styles/footer.css";
import "../styles/illust.css";

import { Image } from "astro:assets";
import viviyNight from "../assets/images/illustrations/Viiviiy_Night.png";
import viviyWhisper from "../assets/images/illustrations/viiviiy_whisper.png";
import viviyDungeon from "../assets/images/illustrations/viiviiy_dungeon.png";
import viviyBuncake from "../assets/images/illustrations/viiviiy_buncake.png";
import viviyFrieren from "../assets/images/illustrations/viiviiy_frieren.png";
import viviyBreakfast from "../assets/images/illustrations/viiviiy_breakfast.png";
import viviyPonyo from "../assets/images/illustrations/viiviiy_ponyo.png";
import viviyBirds from "../assets/images/illustrations/viiviiy_birds.png";
import viviyColor from "../assets/images/illustrations/viiviiy_color.png";
import viviySeal from "../assets/images/illustrations/viiviiy_seal.png";
import viviyTooth from "../assets/images/illustrations/viiviiy_tooth.png";
import viviyStrawberry from "../assets/images/illustrations/viiviiy_strawberry.png";
import viviyRedHouse from "../assets/images/illustrations/viiviiy_redhouse.png";
import viviyPhoto from "../assets/images/illustrations/viiviiy_photo.png";
import viviySky from "../assets/images/illustrations/viiviiy_sky.png";
import viviyLetsGo from "../assets/images/illustrations/viiviiy_letsgo.png";
---

<Layout>
  <Header />

  <body>
    <section class="all">
      <div class="header">
        <h1>illustration</h1>
        <p class="lit">character art & background design</p>
      </div>

      <section id="gallery">
        <div class="gallery">
          <div class="item" style="grid-area: box-1;">
            <Image src={viviyNight} alt="Viiviiy Night" />
          </div>

          <div class="item" style="grid-area: box-2;">
            <Image src={viviyWhisper} alt="Viiviiy Whisper" />
          </div>

          <div class="item" style="grid-area: box-3;">
            <Image src={viviyDungeon} alt="Viiviiy Dungeon" />
          </div>

          <div class="item" style="grid-area: box-4;">
            <Image src={viviyBuncake} alt="Viiviiy Buncake" />
          </div>

          <div class="item" style="grid-area: box-5;">
            <Image src={viviyFrieren} alt="Viiviiy Frieren" />
          </div>

          <div class="item" style="grid-area: box-6;">
            <Image src={viviyBreakfast} alt="Viiviiy Breakfast" />
          </div>

          <div class="item" style="grid-area: box-7;">
            <Image src={viviyPonyo} alt="Viiviiy Ponyo" />
          </div>

          <div class="item" style="grid-area: box-8;">
            <Image src={viviyBirds} alt="Viiviiy Birds" />
          </div>
          <div class="item" style="grid-area: box-9;">
            <Image src={viviySeal} alt="Viiviiy Seal" />
          </div>

          <div class="item" style="grid-area: box-10;">
            <Image src={viviyColor} alt="Viiviiy Color" />
          </div>

          <div class="item" style="grid-area: box-11;">
            <Image src={viviyTooth} alt="Viiviiy Tooth" />
          </div>

          <div class="item" style="grid-area: box-12;">
            <Image src={viviyStrawberry} alt="Viiviiy Strawberry" />
          </div>

          <div class="item" style="grid-area: box-13;">
            <Image src={viviyRedHouse} alt="Viiviiy Red House" />
          </div>

          <div class="item" style="grid-area: box-14;">
            <Image src={viviyPhoto} alt="Viiviiy Photo" />
          </div>

          <div class="item" style="grid-area: box-15;">
            <Image src={viviySky} alt="Viiviiy Sky" />
          </div>

          <div class="item" style="grid-area: box-16;">
            <Image src={viviyLetsGo} alt="Viiviiy Let's Go" />
          </div>
        </div>
      </section>
    </section>

    
  </body>


</Layout>
