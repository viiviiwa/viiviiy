---
import Layout from "../layouts/Layout.astro";
import Header from "../components/Header.astro";
import "../styles/footer.css";
import "../styles/abt.css";

import { Image } from "astro:assets";
import viiviiy_pp from "../assets/images/pfp2blue.png";
---

<Layout>
  <Header />

  <div class="header">
    <h1>about me</h1>
    <p>animator & designer</p>
  </div>

  <div class="abtme">
    <Image class="profileimg" src={viiviiy_pp} alt="Profile Picture" />
    <div class="text-box">
      <h2>⊹ nice to meet you ⊹</h2>
      <p class="abt-text">
        My background is in illustration and animation. I love to bring
        characters to life through 2D animation and visual development. I
        specialise in 2D character animation (storyboarding & rough animation)
        and visual development!
      </p>
      <p class="abt-text">
        I am also currently expanding into UI/UX design, exploring how
        interactivity and thoughtful design can enhance user experiences while
        drawing on my creative background in storytelling and visual
        communication.
      </p>
      <p class="abt-text">
        I've graduated from UTS with a Bachelors of Design in Animation, and I
        am now working on my Masters in Interaction Design and Electronic Arts
        at the University of Sydney.
      </p>

      <h3>skills</h3>

      <ul class="skills-list">
        <li>UI & UX Design</li>
        <li>Balsamiq</li>
        <li>Figma</li>
        <li>Storyboarding</li>
        <li>Visual Design</li>
        <li>Concept Art</li>
        <li>Adobe</li>
        <li>Illustration</li>
        <li>Motion Graphics</li>
        <li>Blender</li>
        <li>ToonBoom Harmony</li>
      </ul>
    </div>
  </div>

  <section class="exp">
    <h2>experience —</h2>
    <ul class="exp-list">
      <li>
        Intern @ Armchair Productions
        <span class="abt-date">(July 2024 &ndash; Sep 2024)</span>

        <p class="abt-hang">
          Contributed to creating special affects animation assets, that matched
          the visual style of the production
        </p>
      </li>

      <li>
        Animator <span class="abt-date">(2021 &ndash; 2023)</span>
        <p class="abt-hang">
          Worked on a wide array of short films, leading with concept art,
          storyboarding & animation
        </p>
      </li>

      <li>
        Freelancer <span class="abt-date">(Ongoing)</span>
        <p class="abt-hang">
          Communicated and created Illustrations &amp; animations for a wide
          range of clients (twitch assets, logos)
        </p>
      </li>
    </ul>
  </section>
</Layout>
