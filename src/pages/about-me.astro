---
import Layout from "../layouts/Layout.astro";
import { Image } from "astro:assets";
import viiviiy_pp from "../assets/images/viiviiy_pp.png";
---

<Layout>
  <div class="abtmepg">
    <Image class="profileimg" src={viiviiy_pp} alt="Profile Picture" />
    <div class="abtmetext-box">
      <h1 class="abth1">⊹ hello ⊹</h1>
      <p class="abth2">
        I'm vivi! — a visual storyteller blending art and function!
      </p>

      <p class="abt-text">
        With roots in illustration and animation, I craft designs that move and
        connect.
        <br /> Now exploring UI and UX design, I aim to build experiences that feel
        as good as they look .
      </p>
      <br />
      <span class="skills">Skills — </span>
      <br /><span class="skillslist"
        >UI &amp; Visual Design ⊹ Figma ⊹ Storyboarding ⊹ Concept Art ⊹ Adobe ⊹
        Illustration ⊹ Motion Graphics ⊹ Blender ⊹ ToonBoom Harmony
      </span>
    </div>
  </div>

  <div class="abtexp">
    <h1 class="abth1-ex">experience —</h1>
    <p class="abt-extext">
      ⊹ Intern Armchair Productions <span class="abt-date"
        >(July 2024 - Sep 2024)</span
      > ⊹
      <br />
      <span class="abt-inline"
        >Contributed to creating special affects animation assets, that matched
        the visual style of the production</span
      >

      <br /> ⊹ Animator Short Films at University <span class="abt-date"
        >(2021 - 2023)</span
      > ⊹
      <br />
      <span class="abt-inline"
        >Worked on a wide array of short films, leading / assisting with concept
        art, storyboarding, animation and illustrated assets</span
      >

      <br /> ⊹ Freelancer <span class="abt-date">(Ongoing)</span> ⊹
      <br />
      <span class="abt-inline"
        >Communicated and created Illustrations &amp; animation for a wide range
        of clients, creating Twitch Assets</span
      >
    </p>
  </div>
</Layout>
