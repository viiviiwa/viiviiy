---
import Layout from "../layouts/Layout.astro";
import "../styles/index.css";
import "../styles/footer.css";
import { Image } from "astro:assets";
import viviflood from "../assets/images/design/floodmates2.png";
import viviMarket from "../assets/videos/market.gif";

import soupa from "../assets/videos/gifs/soupa.gif";
import viviyPonyo from "../assets/images/illustrations/viiviiy_ponyo.png";
import viviRocket from "../assets/images/illustrations/rocket.png";
import logo from "../assets/images/logosig1.png";
---

<Layout>
  <section class="landing">
    <div class="landing-text">
      <nav class="header-nav">
        <a class="column logo" href="/about-me"
          ><Image src={logo} alt="logo" /></a
        >
        <a class="column about" href="/about-me">about</a>
      </nav>

      <h1>
        <span class="bold">hello</span>
        <span class="break">im vivi</span>
      </h1>

      <nav id="navbar">
        <a class="nav-link anim" href="/animations">animation</a>
        <a class="nav-link design" href="/designs">design</a>
        <a class="nav-link illust" href="/illustrations">illustration</a>
      </nav>

      <p class="text">
        I'm a Sydney based Animator
        <span class="break"> currently studying UI/UX </span>
      </p>

      <ul class="skills-list">
        <li>UI & UX Design</li>
        <li>Balsamiq</li>
        <li>Figma</li>
        <li>Storyboarding</li>
        <li>Visual Design</li>
        <li>Concept Art</li>
        <li>Adobe</li>
        <li>Illustration</li>
        <li>Motion Graphics</li>
        <li>Blender</li>
        <li>ToonBoom Harmony</li>
      </ul>

      <p class="lets">
        let's
        <a class="chat" href="mailto:vivienneyao20@gmail.com" class="chat">
          chat!
        </a>
      </p>
    </div>

    <!-- arrow -->
    <a href="#gallery-section">
      <svg
        class="arrow"
        viewBox="0 0 200 100"
        xmlns="http://www.w3.org/2000/svg"
      >
        <line class="arrow-line" x1="65" x2="100" y1="45" y2="80"></line>
        <line class="arrow-line" x1="135" x2="100" y1="45" y2="80"></line>
      </svg>
    </a>

    <div class="shapes">
      <div class="circles circ1"></div>
      <div class="circles circ2"></div>
      <div class="circles circ3"></div>
      <div class="circles circ4"></div>
    </div>
  </section>

  <section id="gallery-section">
    <div class="land-gallery">
      <div class="item" style="grid-area: box-1">
        <Image src={viviRocket} alt="rocket" />
      </div>
      <div class="item" style="grid-area: box-2">
        <Image src={viviflood} alt="UI Design" />
      </div>
      <div class="item" style="grid-area: box-3">
        <Image src={viviMarket} alt="market" />
      </div>
      <div class="item" style="grid-area: box-4">
        <Image src={viviyPonyo} alt="ponyo" />
      </div>
      <div class="item" style="grid-area: box-5">
        <Image src={soupa} alt="soup" />
      </div>
    </div>

    <div class="see-more-section">
      <div class="see-more">
        <h3>see more <span class="break">of my work</span></h3>

        <nav class="navbar2">
          <a class="nav-items" href="/animations">animation</a>
          <a class="nav-items" href="/designs">UI design</a>
          <a class="nav-items" href="/illustrations">illustration</a>
          <a class="nav-items" href="/about-me">about</a>
        </nav>
      </div>
    </div>
  </section>

  <script></script>
</Layout>
